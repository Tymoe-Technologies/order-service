// ========== 备餐站与打印路由 ==========
// 设计依据见 POS 仓库的 docs/architecture/PRINT_ARCHITECTURE.md

/// 备餐站（热菜 / 冷菜 / 饮品吧 / 打包台）。
///
/// **商品不直接绑打印机，而是绑「站」。** 多这一层间接是必要的 ——
/// 打印机会坏会换会加，但「热菜站」这个概念不变；而且同一个站在不同
/// 门店/不同 POS 上可能对应不同的物理设备（那部分是 POS 本地配置）。
model PrintStation {
  /// 库端生成 id / updated_at 默认值，理由见 MerchantFulfillmentOption
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(64)

  /// 兜底站：没匹配到任何路由的商品进这里。**每租户恰好一个。**
  ///
  /// 没有它的话，商家新加的菜不属于任何站 → 谁都收不到 → 那道菜永远不会被做。
  /// 而这种配置缺失可以隐藏几个月（每次只影响那一个新菜），
  /// 所以它不是「保险」，是必需品。走兜底的商品会在单据上印醒目标记。
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true)  @map("is_active")
  sortOrder Int      @default(0)     @map("sort_order")

  /// 这个站的厨房单渲染配置（形状同 KitchenTicketConfig）。
  /// 放这里而不是 PrintSetting，因为后者有 @@unique([tenantId, ticketType])，
  /// 表达不了「多个站各有自己的版式」
  config    Json?    @db.Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at")

  routes    PrintRoute[]

  @@index([tenantId])
  @@map("print_stations")
}

enum RouteMatchType {
  ITEM      // 商品级，优先级最高
  CATEGORY  // 分类级
}

/// 路由规则：商品或分类 → 站。
///
/// 同一个 (matchType, matchId) 可以有多条记录，也就是**一个商品进多个站**
/// （协作出单，比如奶茶要制茶站做、打包台装袋）。那时每张站单都印全量，
/// 并互相标注「同时在：X 站」—— 否则两个站都以为自己做完就完事了。
model PrintRoute {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  stationId String         @map("station_id") @db.Uuid
  matchType RouteMatchType @map("match_type")
  /// itemId 或 categoryId —— 对 item-management 的跨服务弱引用，
  /// 和 order_items.itemId 是同一种既有模式
  matchId   String         @map("match_id") @db.Uuid

  /// 预留：PRIMARY（主责，出全量）/ NOTIFY（仅知会）。
  /// **当前一律 PRIMARY**。取舍记录见架构文档 §5.2 ——
  /// 「哪个站是主责」很难让商家配对，而配错了比不配更糟。
  /// 字段先占位，免得日后加要迁移
  role      String         @default("PRIMARY") @db.VarChar(16)

  createdAt DateTime       @default(now()) @map("created_at")

  station   PrintStation   @relation(fields: [stationId], references: [id], onDelete: Cascade)

  /// 同一个商品到同一个站只能有一条规则
  @@unique([tenantId, matchType, matchId, stationId])
  @@index([tenantId, matchType, matchId])
  @@map("print_routes")
}

/// 打印职责：哪台设备负责打哪个站 / 哪种票据。
///
/// **这张表是「多 POS + 手持设备」问题的答案。** 手持自己没有打印机，
/// 它下单后由谁来打？纯 POS 本地配置回答不了 —— 必须有一个全店可见的归属登记，
/// 服务端才能把任务**定向**推给正确的设备。
///
/// 现状是向全店在线设备广播、靠客户端各自去重，而去重键在各自的本地存储里、
/// 互相不知道 —— 多台 POS 在线时同一张单会被打多份。
model PrinterAssignment {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid

  /// 打什么。两种取值：
  ///   `station:<stationId>`  —— 某个备餐站的厨房单
  ///   `ticket:<TicketType>`  —— 某类非厨房票据（`ticket:CUSTOMER_RECEIPT`）
  ///
  /// 为什么合成一个字符串，而不是 stationId + ticketType 两个可空列：
  /// Postgres 的唯一索引把 NULL 当互不相等，`@@unique([tenantId, stationId, ticketType])`
  /// 在 station_id IS NULL 时压根不生效 —— 同一种票据能插进两条归属记录，
  /// 于是**两台机器都收到任务、同一张单打两份**，正是这次要消灭的 bug。
  /// 正解是部分唯一索引，但 Prisma 表达不了、`db push` 会把它删掉（见 migrations-manual/README）。
  /// 合成键让约束落在 Prisma 能表达的范围内。
  scope            String   @db.VarChar(80)

  /// 主责设备。用 POS 的设备码（auth-service 分配的那个），
  /// 不用 WS 连接 id —— 后者每次重连都变
  deviceId         String   @map("device_id") @db.VarChar(255)
  /// 主责离线时转推这台。为空 = 任务留队列等主责回来 + 告警
  fallbackDeviceId String?  @map("fallback_device_id") @db.VarChar(255)

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @default(now()) @map("updated_at")

  @@unique([tenantId, scope])
  @@index([tenantId])
  @@map("printer_assignments")
}

// 商家在线点单配置
// 注意：商家身份字段（subdomain / customDomain / themeSettings）已全部迁移到 auth-service.Organization
// 会员开关 memberEnabled 由 member-service.MemberConfig 负责，本表不再保留
// parentMerchantId 保留：由 createConfig 时从 auth-service 同步过来，作为本服务内部的层级运维数据
model MerchantOnlineOrderConfig {
  id               String   @id @default(uuid()) @db.Uuid
  merchantId       String   @unique @map("merchant_id") @db.Uuid
  parentMerchantId String?  @map("parent_merchant_id") @db.Uuid // 主店ID（同步自 auth-service.Organization.parentOrgId）
  enabled          Boolean  @default(true)

  // ⚠️ 已废弃：履约方式改由 MerchantFulfillmentOption 逐条管理。
  // 每加一种方式就要加一列的结构撑不住扩展（curbside / drive-thru / 自提柜…）。
  // 这三列暂时保留并与新表双写，等所有调用方切完再删。
  allowPickup      Boolean  @default(true) @map("allow_pickup")
  allowDineIn      Boolean  @default(true) @map("allow_dine_in")
  allowDelivery    Boolean  @default(true) @map("allow_delivery")

  // 营业时间已迁移到 auth-service Organization.businessHours；DB 列保留但不再写入，后续 migration 可删
  businessHours    Json?    @map("business_hours") @db.Json

  // 订单设置
  minOrderAmount   Int?     @map("min_order_amount") // 最低订单金额(分)
  deliveryFee      Int?     @map("delivery_fee")     // 配送费(分)
  deliveryRadius   Decimal? @map("delivery_radius") @db.Decimal(10, 2) // 配送半径(公里)

  // 自取预约配置
  allowPickupSchedule  Boolean @default(true)  @map("allow_pickup_schedule")   // 是否允许预约自取
  pickupLeadMinutes    Int     @default(15)     @map("pickup_lead_minutes")     // 最早可预约提前量（分钟）
  pickupSlotInterval   Int     @default(30)     @map("pickup_slot_interval")    // 时间槽间隔（分钟）
  pickupAdvanceDays    Int     @default(0)      @map("pickup_advance_days")     // 可提前预约天数（0=仅今天）

  // 时间戳
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([merchantId])
  @@index([parentMerchantId])
  @@index([enabled])
  @@map("merchant_online_order_configs")
}

// 门店启用了哪些履约方式（替代 MerchantOnlineOrderConfig 的三个 allow* 布尔列）
//
// 一种方式一行：加 curbside / drive-thru / 自提柜只是插一行数据 + 枚举加个值，
// 不用再改 schema、validator、DTO、前端类型这一整串。
// GIFT_CARD 不是履约方式，不会出现在这张表里。
//
// config 里放该方式专属的设置，各方式互不相干，不值得为它们各开一列：
//   CURBSIDE   { requireVehicleInfo: true, spotCount: 6, instructions: "..." }
//   DRIVE_THRU { laneCount: 2 }
//   DINE_IN    { requireTableNumber: true }
//   DELIVERY   配送半径/配送费仍在 MerchantOnlineOrderConfig（历史字段，未搬）
model MerchantFulfillmentOption {
  /// 由**数据库**生成而不是 Prisma 客户端。
  /// 库里本来就有 `gen_random_uuid()` 默认值，schema 一直没写 —— 于是
  /// `prisma db push` 会把它当成多余的删掉，之后任何绕过 Prisma 的写入
  /// （原始 SQL、别的服务、手工插数据）都会因为拿不到 id 而失败。
  /// 写进来是为了让 schema 反映真实状态，顺带多一层防御。
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId      String    @map("merchant_id") @db.Uuid
  fulfillmentType OrderType @map("fulfillment_type")
  enabled         Boolean   @default(false)
  // 顾客端选择器里的排列顺序
  displayOrder    Int       @default(0) @map("display_order")
  config          Json?     @db.Json

  createdAt       DateTime  @default(now()) @map("created_at")
  /// @default(now()) 是补的：@updatedAt 只管**更新**时刷新，不产生插入默认值，
  /// 而库里那个 CURRENT_TIMESTAMP 是插入时用的。少了它 db push 会删掉库端默认值。
  updatedAt       DateTime  @updatedAt @default(now()) @map("updated_at")

  @@unique([merchantId, fulfillmentType])
  @@index([merchantId, enabled])
  @@map("merchant_fulfillment_options")
}

// 结账快照（用于支付前锁定订单信息）
model CheckoutSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  merchantId      String   @map("merchant_id") @db.Uuid
  status          String   @default("PENDING") @db.VarChar(20)  // PENDING | USED | EXPIRED

  // 用户关联（可选，未登录时为空，验证后回填）
  consumerId      String?   @map("consumer_id") @db.Uuid

  // 完整订单数据
  orderType       OrderType @map("order_type")
  customerName    String    @map("customer_name") @db.VarChar(255)
  customerPhone   String    @map("customer_phone") @db.VarChar(50)
  customerEmail   String?   @map("customer_email") @db.VarChar(255)
  items           Json      @db.Json                          // 商品列表（验证后的价格）
  pricing         Json      @db.Json                          // 价格明细
  notes           String?   @db.Text
  customLabelData Json?     @map("custom_label_data") @db.Json  // 顾客自定义标签数据
  deliveryAddress Json?     @map("delivery_address") @db.Json   // 配送地址（DELIVERY 类型时）
  vehicleInfo     Json?     @map("vehicle_info") @db.Json       // 车辆信息（CURBSIDE 类型时）
  scheduledAt     DateTime? @map("scheduled_at")                // 预约取餐时间（预约订单时有值）

  // 关联字段（支付成功后填入）
  paymentIntentId String?   @unique @map("payment_intent_id") @db.VarChar(255)
  orderId         String?   @unique @map("order_id") @db.Uuid

  // 时间戳
  createdAt       DateTime  @default(now()) @map("created_at")
  expiresAt       DateTime  @map("expires_at")                // 过期时间（30分钟）

  @@index([merchantId, status])
  @@index([status, expiresAt])  // 用于定时清理
  @@map("checkout_snapshots")
}

// 取餐号配置（每个租户一条，全渠道共享计数器）
model PickupNumberConfig {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @unique @map("tenant_id") @db.Uuid
  startAt         Int      @default(1) @map("start_at")
  showPrefix      Boolean  @default(true) @map("show_prefix")
  channelPrefixes Json     @default("{}") @map("channel_prefixes") @db.Json
  // channelPrefixes 格式：{ "POS": "P", "WEB": "W", "KIOSK": "K" }，未配置的渠道用内置默认值
  queueDisplayEnabled Boolean @default(false) @map("queue_display_enabled") // 开启叫号屏（开启后订单必须走完整状态流程）
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("pickup_number_configs")
}

/// 事件待发板。见 migrations/20260818140000_outbox_events。
///
/// 「要通知的事」和业务数据写在同一个事务里，再由 relay 一条条投递。
/// 一个事件一个 handler 一行 —— 重试只重试失败的那个，不会把已成功的重跑一遍。
model OutboxEvent {
  /// 由**数据库**生成而不是 Prisma 客户端。
  /// 库里本来就有 `gen_random_uuid()` 默认值，schema 一直没写 —— 于是
  /// `prisma db push` 会把它当成多余的删掉，之后任何绕过 Prisma 的写入
  /// （原始 SQL、别的服务、手工插数据）都会因为拿不到 id 而失败。
  /// 写进来是为了让 schema 反映真实状态，顺带多一层防御。
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(50)
  handler       String    @db.VarChar(80)
  aggregateId   String?   @map("aggregate_id") @db.Uuid
  payload       String                            // 事件原文，byte-exact
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  lastError     String?   @map("last_error")

  @@index([publishedAt, nextAttemptAt, createdAt])
  @@index([aggregateId])
  @@map("outbox_events")
}

/// 幂等键存储。见 migrations/20260818120000_idempotency_store。
///
/// 判重和「订单当前长什么样」解耦：记下这个 key 处理过、当时回了什么，
/// 重发直接回放原始响应。以后 addItems / voidItem 这些可重试的写操作复用同一张表。
model IdempotencyKey {
  tenantId     String    @map("tenant_id") @db.Uuid
  endpoint     String    @db.VarChar(100)          // "orders.create" / "orders.addItems"
  key          String    @db.VarChar(255)          // 客户端提供，建单用 orders.id
  fingerprint  String    @db.VarChar(64)           // 规范化请求体的 sha256
  responseBody String?   @map("response_body")   // 原始响应字节，见迁移里的说明
  status       String    @default("IN_PROGRESS") @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  expiresAt    DateTime  @map("expires_at")

  @@id([tenantId, endpoint, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// 取餐号当日计数器（原子自增，全渠道共享，消除并发竞态）
model PickupCounter {
  tenantId    String   @map("tenant_id") @db.Uuid
  date        DateTime @db.Date                              // 当天日期，每天自动重置
  counter     Int                                           // 当日最新取餐号

  @@id([tenantId, date])
  @@map("pickup_counters")
}
